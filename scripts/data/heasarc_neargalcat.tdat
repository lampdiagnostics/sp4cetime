<HEADER>
#
#         TABLE: heasarc_neargalcat
#      LOCATION: dbms1.gsfc.nasa.gov:heasarcprod
#    TOTAL ROWS: 869
#
# CREATION DATE: 2020-09-28 16:47:26
# LAST MODIFIED: 2020-09-28 16:47:26
#   EXGEST DATE: 2020-09-30 01:57:31
#
table_name = heasarc_neargalcat
table_description = "Updated Nearby Galaxy Catalog"
table_document_url = http://heasarc.gsfc.nasa.gov/W3Browse/galaxy-catalog/neargalcat.html
table_security = public
#
# Table Parameters
#
field[name] = char18  [meta.id;meta.main] (index) // Galaxy Designation in well-Known catalogs
field[ra] = float8:.4f_degree [pos.eq.ra;meta.main] (key) // Right Ascension
field[dec] = float8:.4f_degree [pos.eq.dec;meta.main] (key) // Declination
field[lii] = float8:.4f_degree [pos.galactic.lon] (index) // Galactic Longitude
field[bii] = float8:.4f_degree [pos.galactic.lat] (index) // Galactic Latitude
field[major_axis] = float8:6.2f_arcmin [phys.angSize.smajAxis]  // Major Axis (Angular Diameter)
field[axial_ratio] = float8:4.2f  [phys.angSize.smajAxis;phys.angSize.sminAxis;arith.ratio]  // Apparent Axial Ratio
field[bmag_gal_extinction] = float8:4.2f_mag [phys.absorption;em.opt.B]  // Galactic Extinction in B Band
field[fuv_mag_limit] = char1  [meta.code;phot.mag;em.UV.100-200nm]  // Limit Flag for GALEX FUV Band Magnitude
field[fuv_mag] = float8:5.2f_mag [phot.mag;em.UV.100-200nm]  // GALEX FUV Band Magnitude
field[bmag] = float8:5.2f_mag [phot.mag;em.opt.B] (index) // Integral B Band Magnitude
field[halpha_mag_limit] = char1  [meta.code;phot.mag;em.line.Halpha]  // Limit Flag for Integral H-alpha Line Emission Magnitude
field[halpha_mag] = float8:5.2f_mag [phot.mag;em.line.Halpha]  // Integral H-alpha Line Emission Magnitude
field[ks_mag] = float8:5.2f_mag [phot.mag;em.IR.K] (index) // 2MASS K_s Band Magnitude
field[ks_mag_flag] = char1  [meta.code;phot.mag;em.IR.K] (index) // Flag [C] Indicates K_s Band Magnitude Was Derived
field[h1_21_cm_mag_limit] = char1  [meta.code;phot.mag;em.line.HI]  // Limit Flag for H I 21-cm Line Magnitude
field[h1_21_cm_mag] = float8:6.2f_mag [phot.mag;em.line.HI]  // H I 21-cm Line Magnitude
field[h1_21_cm_50pc_width] = int2:3d_km/s [spect.line.width]  // H I Line Width at 50% Level from Maximum
field[morph_type] = int2:2d  [src.morph.type]  // Morphology Type Code
field[dwarf_morph_type] = char5  [src.morph.type]  // Dwarf Galaxy Morphology
field[dwarf_surf_brightness] = char1  [src.morph.type]  // Dwarf Galaxy Surface Brightness Morphology
field[radial_velocity] = int2:4d_km/s [spect.dopplerVeloc] (index) // Heliocentric Radial Velocity
field[distance] = float8:5.2f_Mpc [pos.distance] (index) // Distance to Galaxy
field[distance_method] = char4  [meta.code;pos.distance]  // Method Used to Obtain Distance
field[linear_diameter] = float8:5.2f_kpc [phys.size.diameter] (index) // Major Linear Diameter
field[inclination] = int2:2d_degree [src.orbital.inclination]  // Inclination
field[h1_rot_velocity] = int2:3d_km/s [phys.veloc.rotat;em.line.HI]  // Amplitude of Rotational Velocity
field[bmag_int_extinction] = float8:4.2f_mag [phys.absorption;em.opt.B]  // Internal B Band Extinction
field[abs_bmag] = float8:5.1f_mag [phys.magAbs;em.opt.B] (index) // Absolute B Band Magnitude
field[bmag_surface_brightness] = float8:4.1f_mag/arcsec^2 [phot.mag.sb;em.opt.B]  // Average B Band Surface Brightness
field[log_ks_luminosity] = float8:5.2f_log(Solar_Luminosity) [phys.luminosity;em.IR.K]  // Logarithm of K_s Band Luminosity
field[log_mass_26] = float8:5.2f_log(Solar_Mass) [phys.mass]  // Logarithm of Mass within Holmberg Radius
field[log_h1_mass_limit] = char1  [meta.code;phys.mass]  // Limit Flag for Logarithm of Hydrogen Mass
field[log_h1_mass] = float8:5.2f_log(Solar_Mass) [phys.mass]  // Logarithm of Hydrogen Mass
field[lg_radial_velocity] = int2:4d_km/s [spect.dopplerVeloc] (index) // Radial Velocity Relative to the Local Group Centroid
field[tidal_index_1] = float8:4.1f  [meta.code]  // Tidal Index
field[neighbor_galaxy_name] = char15  [meta.id.assoc]  // Main Disturber, Neighboring Galaxy That Produces the Maximal Tidal Influence
field[tidal_index_2] = float8:4.1f  [meta.code]  // Another Tidal Index
field[log_ks_lum_density] = float8:5.2f  [phys.luminosity;arith.ratio]  // Logarithm of K_s Band Luminosity Density
field[class] = int2  [src.class] (index) // Browse Object Classification
#
parameter_defaults = name ra dec bmag ks_mag ks_mag_flag linear_diameter distance radial_velocity abs_bmag
#
# Virtual Parameters
#
catalog_bibcode = 2013AJ....145..101K
declination = @dec
default_search_radius = 30
equinox = 2000
frequency_regime = Infrared
frequency_regime = Optical
frequency_regime = Radio
observatory_name = GALAXY CATALOG
right_ascension = @ra
row_type = Survey Source
table_author = Karachentsev et al.
table_priority = 5
table_type = Object
target_name = @name
unique_key = name
#
# Relationship Definitions
#
relate[class] = heasarc_class(class_id)
#
# Data Format Specification
#
line[1] = name ra dec lii bii major_axis axial_ratio bmag_gal_extinction fuv_mag_limit fuv_mag bmag halpha_mag_limit halpha_mag ks_mag ks_mag_flag h1_21_cm_mag_limit h1_21_cm_mag h1_21_cm_50pc_width morph_type dwarf_morph_type dwarf_surf_brightness radial_velocity distance distance_method linear_diameter inclination h1_rot_velocity bmag_int_extinction abs_bmag bmag_surface_brightness log_ks_luminosity log_mass_26 log_h1_mass_limit log_h1_mass lg_radial_velocity tidal_index_1 neighbor_galaxy_name tidal_index_2 log_ks_lum_density class
#
